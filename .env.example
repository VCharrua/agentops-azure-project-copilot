# Copy to .env for local overrides. This file contains NO secrets, and neither should .env:
# in Azure the app authenticates with a managed identity, locally with `az login`.

# local = deterministic offline adapters (no Azure needed). azure = real Azure services.
COPILOT_MODE=local
COPILOT_APP_VERSION=dev
COPILOT_DATA_DIR=data/synthetic
COPILOT_STATE_DIR=.local/state

# Agent loop
COPILOT_MAX_AGENT_STEPS=6
COPILOT_RETRIEVAL_TOP_K=5

# Human-in-the-loop
COPILOT_APPROVAL_TTL_MINUTES=60
# Header that carries the approver identity. Locally any value works (X-Approver: your.name).
# In Azure, with Container Apps authentication enabled, use X-MS-CLIENT-PRINCIPAL-NAME.
COPILOT_APPROVER_HEADER=X-Approver
COPILOT_ALLOWED_EMAIL_DOMAINS=["alvora-construction.example"]

# Guardrails
COPILOT_GUARDRAIL_FAIL_CLOSED=true
COPILOT_CONTENT_SAFETY_SEVERITY_THRESHOLD=2

# ---- Only needed when COPILOT_MODE=azure (values are Bicep deployment outputs) ----
# COPILOT_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
# COPILOT_FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
# COPILOT_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# COPILOT_FOUNDRY_AGENT_NAME=                # optional: use a definition registered in Foundry Agent Service
# COPILOT_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# COPILOT_SEARCH_INDEX=project-docs
# COPILOT_CONTENT_SAFETY_ENDPOINT=https://<content-safety>.cognitiveservices.azure.com
# AZURE_CLIENT_ID=<client id of the user-assigned managed identity>     # set by Bicep on the Container App
# APPLICATIONINSIGHTS_CONNECTION_STRING=<from Key Vault via Container Apps secret reference>
